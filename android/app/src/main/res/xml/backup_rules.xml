<?xml version="1.0" encoding="utf-8"?>
<!--
  Project XP — règles de sauvegarde Android 11 et antérieurs.

  À ce stade du projet, des informations de compte et d'identité sont conservées
  localement. On préfère donc ne restaurer automatiquement aucune donnée interne
  tant que le stockage sensible n'a pas été séparé des préférences anodines.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
